ui = {{ vault_ui_enabled | bool | lower }}
cluster_name = "fase3-vault"

storage "file" {
  path = "{{ vault_data_path }}"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable     = 1
}

api_addr      = "http://{{ ansible_host | default(inventory_hostname) }}:8200"
cluster_addr  = "http://{{ ansible_host | default(inventory_hostname) }}:8201"
disable_mlock = true
